PORT=3001
FAKE_STORE_API_BASE_URL=https://fakestoreapi.com
CORS_ORIGIN=http://localhost:5173

SALES_INBOX_EMAIL=sales@example.com
DATABASE_PATH=./data/enquiries.sqlite
# Set to true only behind a trusted reverse proxy (load balancer) so rate limiting sees the real client IP
TRUST_PROXY=false
# log (default, writes the email to the log) or smtp
EMAIL_PROVIDER=log
# Only needed when EMAIL_PROVIDER=smtp (SALES_INBOX_EMAIL must then be set above; SMTP_USER and SMTP_PASS go together)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=website@example.com
# Admin page (/admin). Leave unset to disable it. Use a long random value (at least 16 characters):
#   openssl rand -hex 24
# Admin page password. Left unset, development uses the weak placeholder 123 (never in production).
# In production set a long random value, for example: openssl rand -hex 24
# ADMIN_TOKEN=
